package Week2Celestial;

public class Week2A3Celestial {
	public static void main(String[] args) {
		String[] names = {"Ana", "Ben","Carla","Diego"};
		double[][] sales = {
				{18000,20000,15000},
				{12000,15000,18000},
				{22000,18000,17000},
				{10000,12000,14000},
		};
double quota = 50000, basicsalary = 20000;
double totalpayroll = 0;
int quotacount = 0;

System.out.println("NAME SALES QUOTA COMISSION SALARY");
for (int r = 0; r < sales.length; r++) {
	double totalsales = 0;
	for (int c = 0; c < sales[r].length; c++) {
		totalsales += sales[r][c];
	}
	boolean metQuota = totalsales >= quota;
	double comission = metQuota ? totalsales * 0.03 : 0;
	double salary = basicsalary + comission;
	
	if (metQuota) quotacount++;
	totalpayroll += salary;
	
	System.out.printf("%-7s %7.0f %-5s %10.0f %9.0f%n",names[r], 
	totalsales, metQuota ? "YES":"NO",comission, salary);	
}
System.out.println("Quota acheivers: "+quotacount);
System.out.printf("Toal payroll: %.0f%n", totalpayroll);
}
}
